# このファイルを .env にコピーして使う（cp .env.example .env）

# LiveKit 接続情報
# Option 1（livekit-server --dev）の場合はこのまま（開発用固定キー）
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Option 2（docker compose / livekit.yaml）で起動する場合は下記に置き換える:
# LIVEKIT_API_KEY=APIcallcenter
# LIVEKIT_API_SECRET=4e69181c87bc58ac27d8d84509590143bf0a87a47d944821

# デモ用パスコード（本番はDB照合・ワンタイム・失効・試行回数制限に置換）
DEMO_PASSCODE=1234

# トークンサーバ＆Web配信のポート
PORT=3001

# 録画(Egress)を試す場合、ブラウザ向けURL(LIVEKIT_URL)をホストのLAN IPにする（方法B）。
# EgressClient用のHTTP URLは LIVEKIT_URL から自動導出（ws->http）。
# 別ホストのlivekitを使う等でHTTP先を分けたい場合のみ以下を指定:
# LIVEKIT_HTTP_URL=http://localhost:7880
