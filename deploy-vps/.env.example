# token-server 用の環境変数。cp .env.example .env して値を埋める。

# ブラウザに返す LiveKit 接続先（Caddy経由のwss。実ドメインに置換）
LIVEKIT_URL=wss://livekit.example.com

# token-server → livekit の内部HTTP（host net の同ホスト。TLS不要）
LIVEKIT_HTTP_URL=http://127.0.0.1:7880

# livekit.yaml / egress.yaml と一致させる（generate-keys の値）
LIVEKIT_API_KEY=APIkey_REPLACE_ME
LIVEKIT_API_SECRET=SECRET_REPLACE_ME_32chars_or_more________________

# 端末コード（本番はDB照合・端末アカウントに置換）
DEMO_PASSCODE=1234

# 管理画面(/admin.html)のログインパスワード（必ず変更）
ADMIN_PASSWORD=admin1234
# SQLite等の保存先（compose の ./data:/data にマウント）
DATA_DIR=/data

# token-server の待受ポート（Caddyが app.<domain> から中継）
PORT=3001
